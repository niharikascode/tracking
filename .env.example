# Hugging Face token with access to the gated facebook/sam3 model (required)
HF_TOKEN=hf_xxx

# OpenRouter key: enables object detection (Qwen, DeepSeek, Gemini, GPT-6 Sol/Astra)
OPENROUTER_API_KEY=sk-or-xxx

# Access key visitors must enter. Strongly recommended when the site is public.
APP_PASSWORD=

# Detection spending caps (USD) and limits
DETECT_DAILY_USD=2.00
DETECT_TOTAL_USD=20.00
DETECT_MAX_FRAMES=120
DETECT_WORKERS=3

# Other limits
MAX_UPLOAD_MB=1024
MAX_FRAMES_LIMIT=600
MAX_QUEUE=100
DTYPE=fp16
