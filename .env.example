# Hugging Face token with access to the gated facebook/sam3 model (required)
HF_TOKEN=hf_xxx

# Optional: require this access key in the browser before anyone can use the GPU.
# Strongly recommended when the site is exposed publicly.
APP_PASSWORD=

# Optional limits
MAX_UPLOAD_MB=1024
MAX_FRAMES_LIMIT=600
MAX_QUEUE=20
RETENTION_HOURS=48
DTYPE=fp16
